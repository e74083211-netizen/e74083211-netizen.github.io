# 复制为 .dev.vars 用于本地开发（npm run setup 会自动生成随机值）。
# 线上环境不要用这个文件，用 `npx wrangler secret put 名称` 设置。

# 进入私密区域的访问口令（发给寿星的那个）
ACCESS_PASSWORD=change-me-private

# 管理留言用的后台密码，必须和上面的口令不同
ADMIN_PASSWORD=change-me-admin-different

# 会话签名密钥：至少 32 个随机字符。可用 `openssl rand -base64 48` 生成
SESSION_SECRET=replace-with-at-least-32-random-characters
