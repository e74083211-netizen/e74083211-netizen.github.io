// Cloudflare Workers 配置。D1 和 KV 的 ID 是线上资源的编号（不是密码），可以公开。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "birthday-site",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",

  // 只有 public/ 会被当作公开静态文件。private-assets/ 永远不会被上传到这里。
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/audio/*"],
    "not_found_handling": "none"
  },

  // 留言墙数据库（共享、持久）
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "birthday-db",
      "database_id": "d1e094ff-c4bf-4023-bb80-0e15987ac745",
      // 本地预览（npm run dev）用的数据存在这个名字下面，保持不变，本机的账号和留言才不会丢
      "preview_database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  // 私密照片与私密文字（只能通过已解锁的 API 读取）
  "kv_namespaces": [
    {
      "binding": "PRIVATE_KV",
      "id": "b9c0bacb65ff449eb72ecedbd0b32018",
      // 本地预览用的私密内容存在这个名字下面
      "preview_id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],

  // 共同相册的照片（私有存储桶，不开放公共访问；只能通过已解锁的 API 读取）
  // 目前相册是关着的（没有开通 R2）。以后要开：在 Cloudflare 开通 R2 并创建 birthday-album 桶，
  // 去掉下面几行开头的 //，再把 public/site.config.js 里的 sharedAlbum 改成 true，重新部署。
  // "r2_buckets": [
  //   {
  //     "binding": "ALBUM_BUCKET",
  //     "bucket_name": "birthday-album"
  //   }
  // ],

  // 非机密开关。机密（密码、会话密钥）请用 `wrangler secret put`，不要写在这里。
  "vars": {
    "MESSAGE_MODERATION": "off",
    "PRIVATE_SESSION_HOURS": "12"
  },

  "observability": { "enabled": true }
}
